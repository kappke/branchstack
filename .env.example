# Secret used to encrypt GitHub tokens at rest (PBKDF2 -> Fernet).
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
BRANCHSTACK_SECRET_KEY=change-me-please

# Comma-separated CORS origins allowed by the backend.
# Defaults to http://localhost:${BRANCHSTACK_FRONTEND_PORT} when unset.
# BRANCHSTACK_CORS_ORIGINS=http://localhost:8080

# Host ports to expose the services on (container-internal ports are fixed).
BRANCHSTACK_BACKEND_PORT=8000
BRANCHSTACK_FRONTEND_PORT=8080

# Bootstrap admin created on first startup if the users table is empty.
# Change the password from the default after first login.
# BRANCHSTACK_BOOTSTRAP_USERNAME=admin
# BRANCHSTACK_BOOTSTRAP_PASSWORD=admin